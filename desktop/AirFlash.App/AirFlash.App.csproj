<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <OutputType Condition="'$(AirFlashConsole)' == 'true'">Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AirFlash</AssemblyName>
    <Product>AppleHome</Product>
    <Title>AppleHome</Title>
    <Description>Windows system audio to HomePod — GPLv3+ diagnostic preview</Description>
    <RootNamespace>AirFlash.App</RootNamespace>
    <StartupObject>AirFlash.App.Program</StartupObject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <Version>0.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <VbCablePackage Condition="'$(VbCablePackage)' == ''">$(MSBuildProjectDirectory)/../../artifacts/vendor/VBCABLE_Driver_Pack45.zip</VbCablePackage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AirFlash.Core/AirFlash.Core.csproj"/>
    <PackageReference Include="NAudio" Version="2.2.1"/>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/PayQrcode.png"/>
    <EmbeddedResource Include="Assets/app.ico" LogicalName="AirFlash.Icon.ico"/>
    <EmbeddedResource Include="Assets/ThirdPartyNotices.txt" LogicalName="AirFlash.ThirdPartyNotices.txt"/>
    <EmbeddedResource Include="../../native/airflash-engine/target/release/airflash-engine.exe" LogicalName="AirFlash.Engine.exe" Condition="Exists('../../native/airflash-engine/target/release/airflash-engine.exe')"/>
    <EmbeddedResource Include="$(VbCablePackage)" LogicalName="AirFlash.VbCable.zip" Condition="Exists('$(VbCablePackage)')"/>
  </ItemGroup>
  <Target Name="RequireEngineForPublish" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('../../native/airflash-engine/target/release/airflash-engine.exe')" Text="Build the Rust engine first with scripts/build-native.ps1."/>
    <Error Condition="!Exists('$(VbCablePackage)')" Text="Prepare the original VB-CABLE package with scripts/prepare-native-driver.ps1 before publishing."/>
    <GetFileHash Files="$(VbCablePackage)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="VbCableHash"/></GetFileHash>
    <Error Condition="'%(VbCableHash.FileHash)' != 'B950E39F01AF1D04EA623C8F6D8EB9B6EA5C477C637295FABF20631C85116BFB'" Text="VB-CABLE input must be the verified, unmodified Pack45 archive."/>
  </Target>
  <Target Name="AuditWindowsCompatibility" BeforeTargets="GenerateSingleFileBundle" DependsOnTargets="PrepareForBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <CompatibilityArtifacts>$(MSBuildProjectDirectory)/../../artifacts/compatibility</CompatibilityArtifacts>
    </PropertyGroup>
    <MakeDir Directories="$(CompatibilityArtifacts)"/>
    <WriteLinesToFile File="$(CompatibilityArtifacts)/bundle-inputs.txt" Lines="@(FilesToBundle->'%(FullPath)')" Overwrite="true" Encoding="UTF-8"/>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../.." Command="uv run --no-sync python -m scripts.compatibility_audit --manifest &quot;$(CompatibilityArtifacts)/bundle-inputs.txt&quot; --file &quot;$(MSBuildProjectDirectory)/../../native/airflash-engine/target/release/airflash-engine.exe&quot; --source-root . --output &quot;$(CompatibilityArtifacts)/bundle-audit.json&quot;"/>
  </Target>
</Project>
