<Window x:Class="AirFlash.App.Ui.NativeSetupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AppleHome" Width="520" Height="420" MinWidth="440" MinHeight="380"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
 Background="{DynamicResource SetupPaper}" Foreground="{DynamicResource SetupInk}">
 <Window.Resources>
  <SolidColorBrush x:Key="SetupPaper" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SetupCanvas" Color="#F1F2F4"/>
  <SolidColorBrush x:Key="SetupFooter" Color="#F1F2F4"/>
  <SolidColorBrush x:Key="SetupInk" Color="#1D1D1F"/>
  <SolidColorBrush x:Key="SetupMuted" Color="#626266"/>
  <SolidColorBrush x:Key="SetupLine" Color="#DEDEE2"/>
  <SolidColorBrush x:Key="SetupAccent" Color="#1769D2"/>
  <SolidColorBrush x:Key="SetupAccentText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SetupHover" Color="#EDEEF2"/>
  <SolidColorBrush x:Key="SetupAccentHover" Color="#135AB6"/>
  <SolidColorBrush x:Key="SetupPressed" Color="#E2E3E8"/>
  <SolidColorBrush x:Key="SetupPressedText" Color="#1D1D1F"/>
  <SolidColorBrush x:Key="SetupAccentPressed" Color="#0D4899"/>
  <SolidColorBrush x:Key="SetupButtonFill" Color="#F7F7F9"/>
  <SolidColorBrush x:Key="SetupButtonBorder" Color="#D0D0D5"/>
  <Style x:Key="SetupButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource SetupInk}"/>
   <Setter Property="Background" Value="{DynamicResource SetupButtonFill}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SetupButtonBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="MinHeight" Value="36"/>
   <Setter Property="MinWidth" Value="98"/>
   <Setter Property="Padding" Value="18,8"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
    </ControlTemplate></Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SetupHover}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SetupPressed}"/><Setter Property="Foreground" Value="{DynamicResource SetupPressedText}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource SetupAccent}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="SetupPrimary" TargetType="Button" BasedOn="{StaticResource SetupButton}">
   <Setter Property="Background" Value="{DynamicResource SetupAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource SetupAccent}"/>
   <Setter Property="Foreground" Value="{DynamicResource SetupAccentText}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SetupAccentHover}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SetupAccentPressed}"/><Setter Property="Foreground" Value="{DynamicResource SetupAccentText}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="SetupReplay" TargetType="Button" BasedOn="{StaticResource SetupButton}">
   <Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="182"/>
   <Setter Property="Foreground" Value="{DynamicResource SetupAccent}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Path Width="16" Height="16" Stretch="Uniform" Data="M3,1 L15,8 3,15 Z" Fill="{TemplateBinding Foreground}" Margin="0,0,10,0"/>
      <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </StackPanel>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Background="{DynamicResource SetupCanvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="26,22,26,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Viewbox Width="36" Height="36" VerticalAlignment="Center">
    <Path Width="36" Height="36" Data="M4,14 L11,14 20,6 20,30 11,22 4,22 Z M26,11 C32,16 32,20 26,25"
     Stroke="{DynamicResource SetupInk}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
   </Viewbox>
   <StackPanel Grid.Column="2">
    <TextBlock x:Name="HeaderTitle" Text="HomePod" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="DeviceText" FontSize="13" Foreground="{DynamicResource SetupMuted}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="{DynamicResource SetupPaper}" CornerRadius="12" Margin="20,0,20,0">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="22,20,22,18">
    <TextBlock x:Name="TaskTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <TextBlock x:Name="StepText" TextWrapping="Wrap" LineHeight="21" AutomationProperties.LiveSetting="Polite"/>
    <ProgressBar x:Name="Preparation" Height="3" Margin="0,16,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
    <ListBox x:Name="ReceiverPicker" MinHeight="70" MaxHeight="110" Margin="0,12,0,0" Visibility="Collapsed" SelectionChanged="ReceiverSelected"/>
    <Button x:Name="ReplayButton" Style="{StaticResource SetupReplay}" Content="再播放一次" HorizontalAlignment="Left"
     Margin="0,22,0,0" Visibility="Collapsed" Click="ReplayClicked" KeyboardNavigation.TabIndex="0"/>
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource SetupMuted}" FontSize="13" LineHeight="20" Margin="0,16,0,0" Visibility="Collapsed"/>
   </StackPanel>
  </ScrollViewer>
  </Border>
  <Border Grid.Row="2" Background="{DynamicResource SetupFooter}" Padding="26,22">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="AboutButton" Style="{StaticResource SetupButton}" Content="关于" FontSize="12" Foreground="{DynamicResource SetupMuted}"
     MinWidth="0" BorderThickness="0" Background="Transparent" Padding="0" Click="AboutClicked" KeyboardNavigation.TabIndex="3"/>
    <Button x:Name="SecondaryButton" Grid.Column="2" Style="{StaticResource SetupButton}" Content="没听到" Margin="0,0,10,0" Click="SecondaryClicked" KeyboardNavigation.TabIndex="1"/>
    <Button x:Name="PrimaryButton" Grid.Column="3" Style="{StaticResource SetupPrimary}" Content="听到了" Click="PrimaryClicked" KeyboardNavigation.TabIndex="2"/>
   </Grid>
  </Border>
 </Grid>
</Window>
