<Window x:Class="AirFlash.App.Ui.NativeSetupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:AirFlash.App.Ui"
 Title="AppleHome" Width="560" Height="464" MinWidth="440" MinHeight="380"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
 UseLayoutRounding="True" Background="{DynamicResource SetupPaper}" Foreground="{DynamicResource SetupInk}">
 <Window.Resources>
  <SolidColorBrush x:Key="SetupPaper" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SetupCanvas" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SetupFooter" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SetupInk" Color="#1D1D1F"/>
  <SolidColorBrush x:Key="SetupMuted" Color="#626266"/>
  <SolidColorBrush x:Key="SetupLine" Color="#DEDEE2"/>
  <SolidColorBrush x:Key="SetupAccent" Color="#1769D2"/>
  <SolidColorBrush x:Key="SetupAccentBorder" Color="#1260C5"/>
  <SolidColorBrush x:Key="SetupAccentText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SetupAccentHover" Color="#135AB6"/>
  <SolidColorBrush x:Key="SetupAccentPressed" Color="#0D4899"/>
  <SolidColorBrush x:Key="SetupHover" Color="#ECEEF2"/>
  <SolidColorBrush x:Key="SetupHoverText" Color="#464C55"/>
  <SolidColorBrush x:Key="SetupPressed" Color="#E3E6EB"/>
  <SolidColorBrush x:Key="SetupPressedText" Color="#1D1D1F"/>
  <SolidColorBrush x:Key="SetupButtonFill" Color="#F4F5F7"/>
  <SolidColorBrush x:Key="SetupButtonBorder" Color="#E0E3E8"/>
  <SolidColorBrush x:Key="SetupButtonInk" Color="#464C55"/>
  <SolidColorBrush x:Key="SetupReplayFill" Color="#F4F7FC"/>
  <SolidColorBrush x:Key="SetupReplayBorder" Color="#E2E8F1"/>
  <SolidColorBrush x:Key="SetupReplayInk" Color="#1769D2"/>
  <SolidColorBrush x:Key="SetupReplayHover" Color="#E7EFFB"/>
  <SolidColorBrush x:Key="SetupReplayPressed" Color="#DEE8F8"/>
  <SolidColorBrush x:Key="SetupReplayPressedText" Color="#1769D2"/>
  <Style x:Key="SetupButton" TargetType="Button">
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{DynamicResource SetupButtonInk}"/>
   <Setter Property="Background" Value="{DynamicResource SetupButtonFill}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SetupButtonBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="MinWidth" Value="88"/>
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Grid>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource SetupAccent}" BorderThickness="2"
       CornerRadius="11" Opacity="0" IsHitTestVisible="False"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SetupHover}"/><Setter Property="Foreground" Value="{DynamicResource SetupHoverText}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SetupPressed}"/><Setter Property="Foreground" Value="{DynamicResource SetupPressedText}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="SetupPrimary" TargetType="Button" BasedOn="{StaticResource SetupButton}">
   <Setter Property="MinWidth" Value="112"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Background" Value="{DynamicResource SetupAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource SetupAccentBorder}"/>
   <Setter Property="Foreground" Value="{DynamicResource SetupAccentText}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SetupAccentHover}"/><Setter Property="Foreground" Value="{DynamicResource SetupAccentText}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SetupAccentPressed}"/><Setter Property="Foreground" Value="{DynamicResource SetupAccentText}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="SetupReplay" TargetType="Button" BasedOn="{StaticResource SetupButton}">
   <Setter Property="MinWidth" Value="148"/>
   <Setter Property="Background" Value="{DynamicResource SetupReplayFill}"/><Setter Property="BorderBrush" Value="{DynamicResource SetupReplayBorder}"/>
   <Setter Property="Foreground" Value="{DynamicResource SetupReplayInk}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Path Width="8" Height="10" Stretch="Uniform" Data="M0,0 L7,4.5 0,9 Z" Fill="{TemplateBinding Foreground}" Margin="0,0,10,0"/>
       <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </StackPanel>
     </Border>
     <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource SetupAccent}" BorderThickness="2"
      CornerRadius="11" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SetupReplayHover}"/><Setter Property="Foreground" Value="{DynamicResource SetupReplayInk}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SetupReplayPressed}"/><Setter Property="Foreground" Value="{DynamicResource SetupReplayPressedText}"/></Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Background="{DynamicResource SetupPaper}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <StackPanel Margin="26,0,26,12">
    <Viewbox x:Name="DeviceArtwork" Width="120" Height="106" Margin="0,24,0,0" HorizontalAlignment="Center"
     IsHitTestVisible="False" Focusable="False">
     <Canvas Width="120" Height="106">
      <Ellipse Width="76" Height="7" Canvas.Left="22" Canvas.Top="97" Fill="#F0F1F3"/>
      <Path Canvas.Left="8" Canvas.Top="6" Data="M52 0 C84 0 103 19 103 45 C103 75 86 91 52 92 C18 91 1 75 1 45 C1 19 20 0 52 0Z" Stroke="#D0D3D9" StrokeThickness="0.6">
       <Path.Fill><RadialGradientBrush Center="0.4,0.28" GradientOrigin="0.32,0.15" RadiusX="0.85" RadiusY="0.85">
        <GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#F7F8F9" Offset="0.45"/><GradientStop Color="#E1E3E8" Offset="1"/>
       </RadialGradientBrush></Path.Fill>
      </Path>
      <Path Canvas.Left="8" Canvas.Top="6" Opacity="0.45" Data="M52 0 C84 0 103 19 103 45 C103 75 86 91 52 92 C18 91 1 75 1 45 C1 19 20 0 52 0Z">
       <Path.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
        <DrawingBrush.Drawing><GeometryDrawing Geometry="M0 0 L4 4 M0 4 L4 0">
         <GeometryDrawing.Pen><Pen Brush="#BDC3CC" Thickness="0.45"/></GeometryDrawing.Pen>
        </GeometryDrawing></DrawingBrush.Drawing>
       </DrawingBrush></Path.Fill>
      </Path>
      <Ellipse Width="44" Height="15" Canvas.Left="38" Canvas.Top="10" Fill="#F9FAFC" Stroke="#DADDE3" StrokeThickness="0.65"/>
      <Ellipse Width="28" Height="8" Canvas.Left="46" Canvas.Top="13" Fill="#FFFFFF"/>
      <Path Data="M50 17 H54 M52 15 V19 M66 17 H70" Stroke="#D2D6DE" StrokeThickness="0.7"/>
     </Canvas>
    </Viewbox>
    <Viewbox x:Name="GenericArtwork" Width="120" Height="106" Margin="0,24,0,0" HorizontalAlignment="Center"
     Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
     <Canvas Width="120" Height="106">
      <Viewbox Width="72" Height="72" Canvas.Left="24" Canvas.Top="17">
       <Path Width="36" Height="36" Data="M4,14 L11,14 20,6 20,30 11,22 4,22 Z M26,11 C32,16 32,20 26,25"
        Stroke="{DynamicResource SetupInk}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Viewbox>
     </Canvas>
    </Viewbox>
    <TextBlock x:Name="HeaderTitle" Text="HomePod" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
     TextAlignment="Center" Margin="0,10,0,0"/>
    <TextBlock x:Name="DeviceText" FontSize="12" Foreground="{DynamicResource SetupMuted}" TextTrimming="CharacterEllipsis"
     TextAlignment="Center" Margin="0,4,0,0"/>
    <StackPanel x:Name="TaskContent" Margin="0,34,0,0">
     <TextBlock x:Name="TaskTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
     <TextBlock x:Name="StepText" TextWrapping="Wrap" TextAlignment="Center" LineHeight="21" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar x:Name="Preparation" Height="3" Margin="0,16,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
     <ListBox x:Name="ReceiverPicker" MinHeight="70" MaxHeight="110" Margin="0,16,0,0" Visibility="Collapsed" SelectionChanged="ReceiverSelected"/>
     <Button x:Name="ReplayButton" Style="{StaticResource SetupReplay}" Content="{loc:Text 'Play again'}" HorizontalAlignment="Center"
      Margin="0,16,0,0" Visibility="Collapsed" Click="ReplayClicked" KeyboardNavigation.TabIndex="0"/>
     <TextBlock x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SetupMuted}" FontSize="13" LineHeight="20" Margin="0,16,0,0" Visibility="Collapsed"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" Background="{DynamicResource SetupFooter}" Padding="26,17">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="AboutButton" Style="{StaticResource SetupButton}" Content="{loc:Text 'About'}" FontSize="12" Foreground="{DynamicResource SetupMuted}"
     MinWidth="44" MinHeight="32" BorderThickness="0" Background="Transparent" Padding="0" HorizontalContentAlignment="Left" Click="AboutClicked" KeyboardNavigation.TabIndex="3"/>
    <Button x:Name="SecondaryButton" Grid.Column="2" Style="{StaticResource SetupButton}" Content="{loc:Text 'No audio'}" Margin="0,0,12,0" Click="SecondaryClicked" KeyboardNavigation.TabIndex="1"/>
    <Button x:Name="PrimaryButton" Grid.Column="3" Style="{StaticResource SetupPrimary}" Content="{loc:Text 'I heard it'}" Click="PrimaryClicked" KeyboardNavigation.TabIndex="2"/>
   </Grid>
  </Border>
 </Grid>
</Window>
